# LLM Configuration (OpenAI-Compatible API)
# These settings are automatically loaded by OpenAILLMClient
LLM_API_KEY=ollama  # "ollama" for local, or your real API key
LLM_BASE_URL=http://localhost:11434/v1  # Ollama default endpoint
LLM_MODEL=llama3.2  # Default model in Ollama

# Optional: Custom pricing rates ($ per token)
# Set these if you want precise cost tracking for your specific models
# LLM_INPUT_RATE=0.000005    # $ per input token (e.g., GPT-4o)
# LLM_OUTPUT_RATE=0.000015   # $ per output token (e.g., GPT-4o)

# Optional: Model-specific pricing map (JSON string)
# Example for Groq (free) + OpenAI:
# LLM_PRICING_MAP='{"gpt-4o":{"input":0.000005,"output":0.000015}, "groq-llama3":{"input":0,"output":0}}'

# Database Configuration (PostgreSQL 17 with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
